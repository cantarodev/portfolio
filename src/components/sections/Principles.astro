---
import Section from "@/components/sections/Section.astro";
import { PRINCIPLES } from "@/lib/constants";
---

<Section
  id="principles"
  eyebrow="Cómo trabajo"
  title="Principios de ingeniería"
  intro="Una lista corta que uso de verdad al tomar decisiones."
  class="border-t border-crema/5"
>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      PRINCIPLES.map((principle) => (
        <li class="rounded-xl border border-crema/10 bg-crema/[0.02] p-5 transition-transform duration-200 hover:-translate-y-1">
          <h3 class="font-sans text-base font-semibold text-copper">
            {principle.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-crema/65">
            {principle.body}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
