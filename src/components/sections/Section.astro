---
interface Props {
  id: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  class?: string;
}

const { id, eyebrow, title, intro, class: extraClass } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={title ? headingId : undefined}
  class:list={["relative scroll-mt-32 py-12 sm:py-16", extraClass]}
>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    {
      (eyebrow || title || intro) && (
        <header class="mb-8 max-w-3xl">
          {eyebrow && (
            <p class="font-mono text-[11px] tracking-[0.3em] text-term/70 uppercase">
              {eyebrow}
            </p>
          )}
          {title && (
            <h2
              id={headingId}
              class="mt-3 font-sans text-3xl font-semibold tracking-tight text-balance text-crema sm:text-4xl"
            >
              {title}
            </h2>
          )}
          {intro && (
            <p class="mt-4 text-sm leading-relaxed text-crema/60 sm:text-base">
              {intro}
            </p>
          )}
        </header>
      )
    }
    <slot />
  </div>
</section>
