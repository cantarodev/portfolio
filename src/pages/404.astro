---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — Jhon Cantaro" description="Página no encontrada.">
  <div
    class="mx-auto flex min-h-[70svh] w-full max-w-3xl flex-col items-start justify-center px-4 py-32 sm:px-6"
  >
    <p class="font-mono text-[11px] tracking-[0.3em] text-term/70 uppercase">
      Error 404
    </p>
    <h1 class="mt-3 font-sans text-3xl font-semibold tracking-tight text-crema sm:text-4xl">
      Esta ruta no existe
    </h1>
    <p class="mt-3 max-w-prose text-sm leading-relaxed text-crema/60 sm:text-base">
      La página que buscas no está aquí. Puede que se haya movido o que el enlace
      esté roto.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded border border-term/40 bg-term/10 px-4 py-2 font-mono text-xs text-term transition-colors hover:bg-term/20"
      >
        Volver al inicio
      </a>
      <a
        href="/cantaro-labs"
        class="inline-flex items-center gap-1.5 rounded border border-crema/20 px-4 py-2 font-mono text-xs text-crema/70 transition-colors hover:border-crema/40 hover:text-crema"
      >
        Ir a Cantaro Labs
      </a>
    </div>
  </div>
</Layout>
