---
import Layout from "@/layouts/Layout.astro";
import { ArchitectureDiagram } from "@/components/sections/ArchitectureDiagram";
import { GithubIcon } from "@/components/ui/brand-icons";
import { CASE_STUDY, FEATURED_PROJECT, PROJECTS } from "@/lib/constants";

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const featured = project.id === FEATURED_PROJECT.id;

const ctaPrimary =
  "inline-flex items-center gap-2 rounded-lg border border-term/45 bg-term/10 px-5 py-2.5 text-sm font-medium text-term transition-all duration-200 hover:border-term/70 hover:bg-term/20";
const ctaOutline =
  "inline-flex items-center gap-2 rounded-lg border border-crema/20 bg-ink/30 px-5 py-2.5 text-sm font-medium text-crema/80 transition-all duration-200 hover:border-crema/40 hover:text-crema";
---

<Layout
  title={`${project.name} — Caso de estudio`}
  description={project.description}
>
  <article class="mx-auto w-full max-w-4xl px-4 py-24 sm:px-6 sm:py-28">
    <a
      href="/#projects"
      class="font-mono text-[11px] text-crema/60 transition-colors hover:text-term"
    >
      ← Proyectos
    </a>

    <header class="mt-6">
      <p
        class="font-mono text-[11px] tracking-[0.3em] text-term/70 uppercase"
      >
        {project.category ?? "Caso de estudio"}
      </p>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <h1
          class="font-sans text-3xl font-semibold tracking-tight text-crema sm:text-5xl"
        >
          {project.name}
        </h1>
        {project.openSource && (
          <span class="inline-flex items-center gap-1.5 rounded border border-term/40 bg-term/10 px-2.5 py-1 font-mono text-[10px] text-term uppercase">
            Open Source · Reference
          </span>
        )}
      </div>

      <p class="mt-3 font-mono text-sm text-term/85">{project.tagline}</p>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-crema/70 sm:text-base">
        {project.description}
      </p>

      {
        project.metrics && (
          <dl class="mt-7 grid grid-cols-3 gap-3 sm:max-w-lg">
            {project.metrics.map((metric) => (
              <div class="rounded-lg border border-term/20 bg-term/[0.05] px-3 py-2.5 text-center">
                <dt class="font-mono text-[9px] tracking-wide text-crema/60 uppercase">
                  {metric.label}
                </dt>
                <dd class="mt-1 font-sans text-lg font-semibold text-term">
                  {metric.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      <ul class="mt-6 flex flex-wrap gap-1.5">
        {
          project.stack.map((tech) => (
            <li class="rounded border border-crema/15 bg-ink/40 px-2.5 py-1 font-mono text-[10px] text-crema/75">
              {tech}
            </li>
          ))
        }
      </ul>
    </header>

    {
      featured && (
        <>
          <section class="mt-12">
            <h2 class="font-mono text-[11px] tracking-widest text-term/70 uppercase">
              Problema
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-crema/70 sm:text-base">
              {CASE_STUDY.problem}
            </p>
          </section>

          <section class="mt-10">
            <h2 class="font-mono text-[11px] tracking-widest text-term/70 uppercase">
              Enfoque
            </h2>
            <ul class="mt-3 space-y-2.5 text-sm text-crema/70">
              {FEATURED_PROJECT.approach.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-term" aria-hidden />
                  {item}
                </li>
              ))}
            </ul>
          </section>

          <section class="mt-12">
            <h2 class="font-mono text-[11px] tracking-widest text-term/70 uppercase">
              Arquitectura
            </h2>
            <div class="mt-4">
              <ArchitectureDiagram />
            </div>
          </section>

          <section class="mt-10">
            <h2 class="font-mono text-[11px] tracking-widest text-term/70 uppercase">
              Capacidades
            </h2>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {FEATURED_PROJECT.indicators.map((indicator) => (
                <li class="rounded border border-term/30 bg-term/10 px-2.5 py-1 font-mono text-[10px] text-term">
                  {indicator}
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }

    {
      !featured && project.highlights && (
        <section class="mt-12">
          <h2 class="font-mono text-[11px] tracking-widest text-term/70 uppercase">
            Aspectos clave
          </h2>
          <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {project.highlights.map((item) => (
              <li class="flex gap-2.5 rounded-lg border border-crema/10 bg-ink/40 px-3.5 py-3 text-sm leading-relaxed text-crema/70">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-term" aria-hidden />
                {item}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-12 flex flex-wrap gap-3">
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noreferrer" class={ctaPrimary}>
            <GithubIcon className="size-4" /> Repositorio
          </a>
        )
      }
      {
        project.demo && (
          <a href={project.demo} target="_blank" rel="noreferrer" class={ctaPrimary}>
            Ver en vivo ↗
          </a>
        )
      }
      <a href="/#contact" class={ctaOutline}>Hablemos →</a>
    </div>
  </article>
</Layout>
